# --- Ethernet ---
for e in "eth.gmac0 16030000" "eth.gmac1 16040000"; do
    set -- $e; id=$1
    if ! probe_check "$id.probe" starfive,jh7110-dwmac "$2" CONFIG_DWMAC_STARFIVE "GMAC @$2"; then
        skip_fn "$id.mac"; skip_fn "$id.link"; skip_fn "$id.ping"; continue
    fi
    ifc=$(ls "$DEV/net" 2>/dev/null | head -n1)
    if [ -z "$ifc" ]; then
        res FAIL "$id.mac" function function "bound, but no network interface under $DEV/net"
        skip_fn "$id.link"; skip_fn "$id.ping"; continue
    fi
    mac=$(cat /sys/class/net/$ifc/address)
    repro "cat /sys/class/net/$ifc/address"
    if [ $(( 0x${mac%%:*} & 2 )) = 0 ]; then
        res PASS "$id.mac" function "" "$ifc MAC $mac is globally administered (from firmware/EEPROM)"
    else
        res FAIL "$id.mac" function function "$ifc MAC $mac is random/locally administered (firmware did not pass local-mac-address)"
    fi

    wasup=$(( $(cat /sys/class/net/$ifc/flags) & 1 ))
    if [ "$wasup" = 0 ]; then
        echo "ip link set $ifc down" >>"$UNDO"
        ip link set "$ifc" up 2>/dev/null
    fi
    car=0; w=0
    while [ $w -lt 10 ]; do
        [ "$(cat /sys/class/net/$ifc/carrier 2>/dev/null)" = 1 ] && { car=1; break; }
        sleep 1; w=$((w + 1))
    done
    phy=$(readlink /sys/class/net/$ifc/phydev 2>/dev/null)
    ev "phy=${phy##*/} driver=$(basename "$(readlink /sys/class/net/$ifc/phydev/driver 2>/dev/null)" 2>/dev/null)"
    repro "ip link set $ifc up; cat /sys/class/net/$ifc/carrier /sys/class/net/$ifc/speed"
    if [ "$NO_LINK" = 1 ]; then
        res SKIP "$id.link" function option "carrier not checked (--no-link)"
    elif [ "$car" = 1 ]; then
        res PASS "$id.link" function "" "$ifc carrier up at $(cat /sys/class/net/$ifc/speed) Mb/s $(cat /sys/class/net/$ifc/duplex) duplex"
    else
        ev "$(dmesg_for "$ifc" 4)"
        res FAIL "$id.link" function function "$ifc: no carrier after 10 s (cable connected?)"
    fi
    gw=$(ip route 2>/dev/null | awk -v i="$ifc" '$1 == "default" { for (k = 1; k < NF; k++) if ($k == "dev" && $(k + 1) == i) print $3 }' | head -n1)
    # Only one interface usually holds the default route; for the other, any
    # IPv4 neighbour seen on it (e.g. its DHCP server) proves the datapath.
    peer=$gw; what=gateway
    if [ -z "$peer" ]; then
        # /proc/net/arp, not `ip neigh`: busybox ip may lack it. 0x2 = complete.
        peer=$(awk -v i="$ifc" 'NR > 1 && $6 == i && $3 == "0x2" { print $1; exit }' /proc/net/arp 2>/dev/null)
        what=neighbour
    fi
    if [ "$NO_LINK" = 1 ]; then
        res SKIP "$id.ping" function option "not checked (--no-link)"
    elif [ "$car" = 1 ] && [ -n "$peer" ]; then
        repro "ping -c 3 -I $ifc $peer"
        if po=$(ping -c 3 -W 2 -I "$ifc" "$peer" 2>&1); then
            ev "$(printf '%s\n' "$po" | tail -n 2)"
            res PASS "$id.ping" function "" "$what $peer reachable via $ifc"
        else
            ev "$(printf '%s\n' "$po" | tail -n 2)"
            res FAIL "$id.ping" function function "$what $peer not reachable via $ifc"
        fi
    elif [ "$car" = 1 ]; then
        res SKIP "$id.ping" function no-peer "$ifc has carrier but no default route or IPv4 neighbour to ping"
    else
        res SKIP "$id.ping" function hw-absent "no carrier on $ifc"
    fi
    [ "$wasup" = 0 ] && ip link set "$ifc" down 2>/dev/null
done

