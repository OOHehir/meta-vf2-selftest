#!/bin/sh
# vf2-selftest: board self-test for the StarFive VisionFive 2 (JH7110), for
# reporting what works with a given (typically mainline) kernel and for catching
# regressions between kernels/patches.
#
# Every result states the level it reached and claims no more than that:
#   probe     the DT node is enabled and a driver is bound to it
#   function  the feature did something observable (data moved, value read back)
# A FAIL carries a class, so it can be routed to the right place:
#   config-off   no driver for the compatible in this kernel build
#   not-loaded   driver is a module that exists but is not loaded
#   deferred     probe deferred (reason from debugfs devices_deferred)
#   probe-error  driver available but the device is not bound (see dmesg)
#   function     bound, but the functional check failed
#   log          error-level kernel log lines / taint
# A SKIP says why: not-in-dt, disabled-in-dt, hw-absent, probe-failed, option.
# Each result is followed by "# repro:" (how to check it by hand, without this
# script) and "#  |" evidence lines (raw values the verdict was based on).
#
# Output: KTAP on stdout. -o DIR also writes DIR/{ktap.txt,results.tsv,report.md}.
# Exit:   0 no failures, 1 failures (with --baseline: 1 only on regressions),
#         2 usage error.
# Usage:  vf2-selftest [-o DIR] [--baseline FILE] [--no-link] [--stress SECS] [-q]
#         vf2-selftest --compare LABEL=results.tsv LABEL=results.tsv ...
#   -o DIR          write ktap.txt, results.tsv and report.md into DIR
#   --baseline F    compare with an earlier results.tsv; report regressions
#   --no-link       SKIP Ethernet carrier/ping checks (no cables on the bench)
#   --stress SECS   also run stress-ng CPU+memory for SECS, tracking temperature
#   -q              results only on stdout (files still get everything)
#   --compare ...   no testing: print a Markdown matrix of several runs (e.g.
#                   vendor=v.tsv mainline=m.tsv). Runs anywhere, no root needed.

set -u

VERSION=1.0
OUTDIR=""; BASELINE=""; NO_LINK=0; STRESS=0; QUIET=0; COMPARE=0
while [ $# -gt 0 ]; do
    case "$1" in
        -o)         OUTDIR=${2:?-o needs a directory}; shift ;;
        --baseline) BASELINE=${2:?--baseline needs a file}; shift ;;
        --no-link)  NO_LINK=1 ;;
        --stress)   STRESS=${2:?--stress needs seconds}; shift ;;
        -q)         QUIET=1 ;;
        --compare)  shift; COMPARE=1; break ;;
        -h|--help)  sed -n '/^[^#]/q;2,$p' "$0"; exit 0 ;;
        *)          echo "unknown argument: $1" >&2; exit 2 ;;
    esac
    shift
done
# --- --compare: side-by-side Markdown matrix of several results.tsv files ---
if [ "$COMPARE" = 1 ]; then
    [ $# -ge 2 ] || { echo "--compare needs at least two LABEL=results.tsv" >&2; exit 2; }
    for a in "$@"; do
        case "$a" in *=?*) ;; *) echo "bad --compare argument '$a' (want LABEL=FILE)" >&2; exit 2 ;; esac
        [ -r "${a#*=}" ] || { echo "cannot read ${a#*=}" >&2; exit 2; }
    done
    # labels go via the environment (may contain spaces); files stay quoted
    n=$#; labels=""
    for a in "$@"; do labels="$labels${a%%=*}
"; set -- "$@" "${a#*=}"; done
    shift "$n"
    VF2_LABELS=$labels awk -F'\t' '
    function cell(c, id,   s) {
        s = st[c, id]
        if (s == "") return "–"
        if (s == "PASS") return "PASS"
        if (s == "FAIL") return "**FAIL** " cl[c, id]
        return "skip: " cl[c, id]
    }
    BEGIN { split(ENVIRON["VF2_LABELS"], labs, "\n") }
    FNR == 1 { nc++; lab[nc] = labs[nc] }
    $1 == "#env" { env[nc, $2] = $3; next }
    $1 ~ /^#/ { next }
    {
        if (!($1 in seen)) { seen[$1] = 1; ord[++nk] = $1 }
        st[nc, $1] = $2; cl[nc, $1] = $4; det[nc, $1] = $5; cnt[nc, $2]++
    }
    END {
        hdr = "| |"; sep = "|---|"
        for (c = 1; c <= nc; c++) { hdr = hdr " " lab[c] " |"; sep = sep "---|" }
        print "### VisionFive 2 self-test comparison\n"
        print hdr; print sep
        n = split("model kernel kernel.build sbi u-boot efi fdt.md5 kernel.config.md5 os date script", ek, " ")
        for (i = 1; i <= n; i++) {
            line = "| " ek[i] " |"
            for (c = 1; c <= nc; c++) { v = env[c, ek[i]]; gsub(/\|/, "\\|", v); line = line " " (v == "" ? "–" : "`" v "`") " |" }
            print line
        }
        line = "| **pass / fail / skip** |"
        for (c = 1; c <= nc; c++) line = line " " cnt[c, "PASS"] + 0 " / " cnt[c, "FAIL"] + 0 " / " cnt[c, "SKIP"] + 0 " |"
        print line

        print "\n#### Differences (passes in at least one run, not in all)\n"
        print hdr " " lab[1] " detail |"; print sep "---|"
        nd = 0
        for (k = 1; k <= nk; k++) {
            id = ord[k]; np = 0
            for (c = 1; c <= nc; c++) if (st[c, id] == "PASS") np++
            if (np == 0 || np == nc) continue
            line = "| `" id "` |"
            for (c = 1; c <= nc; c++) line = line " " cell(c, id) " |"
            d = det[1, id]; gsub(/\|/, "\\|", d)
            print line " " d " |"; nd++
        }
        if (!nd) print "| (none) |"

        print "\n#### All checks\n"
        print hdr; print sep
        for (k = 1; k <= nk; k++) {
            id = ord[k]; line = "| `" id "` |"
            for (c = 1; c <= nc; c++) line = line " " cell(c, id) " |"
            print line
        }
        print "\n*probe* = DT node enabled + driver bound; *function* = feature observably worked. FAIL classes: config-off, not-loaded, deferred, probe-error, function, log. Per-check evidence and repro commands are in each run'"'"'s ktap.txt."
    }' "$@"
    exit $?
fi

[ "$(id -u)" = 0 ] || { echo "vf2-selftest: must run as root" >&2; exit 2; }
[ -z "$BASELINE" ] || [ -r "$BASELINE" ] || { echo "cannot read baseline $BASELINE" >&2; exit 2; }

# A run changes cpufreq limits, PWM & hw_random state, so a concurrent one (boot
# autorun vs testimage) would see the other's changes: wait for it instead.
if command -v flock >/dev/null 2>&1 && [ -d /run ] && [ -w /run ]; then
    exec 9>/run/vf2-selftest.lock
    flock -n 9 || { echo "vf2-selftest: waiting for another run to finish" >&2; flock 9; }
fi

TMP=$(mktemp -d /tmp/vf2-selftest.XXXXXX) || exit 2
KTAP=$TMP/ktap.txt; RES=$TMP/results.tsv; ENVF=$TMP/env.tsv; UNDO=$TMP/undo
DTIDX=$TMP/dt.idx; DEVIDX=$TMP/dev.idx
: >"$KTAP"; : >"$RES"; : >"$ENVF"; : >"$UNDO"
DBGFS_MOUNTED=0

cleanup() {
    # Restore anything a check changed (cpufreq limits, link state...), even if
    # we were interrupted mid-check. Entries are idempotent; run newest first.
    [ -s "$UNDO" ] && sed '1!G;h;$!d' "$UNDO" | sh 2>/dev/null
    [ "$DBGFS_MOUNTED" = 1 ] && umount /sys/kernel/debug 2>/dev/null
    rm -rf "$TMP"
}
trap cleanup EXIT
trap 'exit 130' INT TERM

# --- Reporting ---
N=0; P=0; F=0; S=0
REPRO=""; EVID=""

emit()  { printf '%s\n' "$*" >>"$KTAP"; printf '%s\n' "$*"; }
diag()  { printf '%s\n' "$*" >>"$KTAP"; [ "$QUIET" = 1 ] || printf '%s\n' "$*"; }
oneline() { printf '%s' "$*" | tr '\t\n' '  '; }

# ev TEXT: queue evidence (may be multi-line) for the next result
ev() { [ -n "$*" ] && EVID="${EVID}$*
"; }
# repro CMD: the command a maintainer can run by hand to check the next result
repro() { REPRO=$*; }

# res STATUS ID LEVEL CLASS DETAIL     STATUS = PASS | FAIL | SKIP
res() {
    st=$1; id=$2; lvl=$3; cls=$4; shift 4; det=$(oneline "$*")
    N=$((N + 1))
    case "$st" in
        PASS) P=$((P + 1)); emit "ok $N $id"
              diag "#   $lvl: $det" ;;
        FAIL) F=$((F + 1)); emit "not ok $N $id"
              diag "#   $lvl FAIL[$cls]: $det" ;;
        SKIP) S=$((S + 1)); emit "ok $N $id # SKIP [$cls] $det" ;;
    esac
    [ -n "$REPRO" ] && diag "#   repro: $REPRO"
    [ -n "$EVID" ] && printf '%s' "$EVID" | while IFS= read -r l; do diag "#    | $l"; done
    printf '%s\t%s\t%s\t%s\t%s\n' "$id" "$st" "$lvl" "$cls" "$det" >>"$RES"
    REPRO=""; EVID=""
}
skip_fn() { res SKIP "$1" function probe-failed "${2:-probe check failed, see above}"; }

envset() { v=$(oneline "$2"); printf '%s\t%s\n' "$1" "$v" >>"$ENVF"; diag "# env: $1 = $v"; }

# --- Small helpers ---
have() { command -v "$1" >/dev/null 2>&1; }
# tmo SECS CMD...: oe-core's busybox has no timeout applet, so run unbounded without it.
tmo() { if have timeout; then timeout "$@"; else shift; "$@"; fi; }
rd()   { [ -r "$1" ] && tr -d '\0' <"$1" 2>/dev/null; }
uptime_cs() { awk '{ printf "%d", $1 * 100 }' /proc/uptime; }
# bytes FILE: one octal byte per line (0xff = 377). oe-core's busybox od has no
# -A/-t (those need CONFIG_DESKTOP), so only -b & -v, which GNU od also has.
bytes() { od -v -b "$1" | awk '{ for (i = 2; i <= NF; i++) print $i }'; }
PDT=/proc/device-tree
MODDIR=/lib/modules/$(uname -r)

kconfig() {   # kconfig CONFIG_FOO -> "y", "m" or "" (not set / unknown)
    [ -r /proc/config.gz ] || return 0
    zcat /proc/config.gz 2>/dev/null | sed -n "s/^$1=//p"
}
have_kconfig() { [ -r /proc/config.gz ]; }

dmesg_raw() { dmesg -r 2>/dev/null || dmesg; }
# kernel log lines mentioning a device (by sysfs name), newest last
dmesg_for() { [ -n "$1" ] && dmesg 2>/dev/null | grep -F -- "$1" | tail -n "${2:-3}"; }

# read_test DEV MiB -> sets RT_MBPS, returns dd status (read-only, page cache dropped)
read_test() {
    sync; echo 3 >/proc/sys/vm/drop_caches 2>/dev/null
    t0=$(uptime_cs)
    dd if="$1" of=/dev/null bs=1048576 count="$2" 2>/dev/null; rc=$?
    t1=$(uptime_cs); dt=$((t1 - t0)); [ "$dt" -gt 0 ] || dt=1
    RT_MBPS=$(awk -v n="$2" -v c="$dt" 'BEGIN { printf "%.1f", n * 100 / c }')
    return $rc
}

# --- Device-tree / driver-model indexes (built once) ---
#   dt.idx:  <node path> TAB okay|disabled TAB <compatibles...>
#            (disabled if the node or any ancestor has status != okay)
#   dev.idx: <node path> TAB <sysfs device dir> TAB <bound driver or empty>
build_indexes() {
    # Trailing slash: /proc/device-tree is a symlink, which find will not enter.
    find "$PDT/" -name compatible -type f 2>/dev/null | sort | while IFS= read -r f; do
        n=${f%/compatible}; p=${n#"$PDT"}; [ -n "$p" ] || p=/
        stt=okay; [ -r "$n/status" ] && stt=$(rd "$n/status")
        printf '%s\t%s\t%s\n' "$p" "$stt" "$(tr '\0' ' ' <"$f")"
    done | awk -F'\t' '{
        dis = 0
        for (i = 1; i <= k; i++) if (index($1, D[i] "/") == 1) dis = 1
        if ($2 != "okay" && $2 != "ok") { D[++k] = $1; dis = 1 }
        print $1 "\t" (dis ? "disabled" : "okay") "\t" $3
    }' >"$DTIDX"

    base=$(readlink -f /sys/firmware/devicetree/base)
    find /sys/devices -name of_node 2>/dev/null | while IFS= read -r l; do
        d=${l%/of_node}; node=$(readlink -f "$l"); node=${node#"$base"}
        drv=""; [ -e "$d/driver" ] && drv=$(basename "$(readlink "$d/driver")")
        printf '%s\t%s\t%s\n' "${node:-/}" "$d" "$drv"
    done >"$DEVIDX"
}

# dt_find COMPAT [UNITADDR] -> "<node>\t<okay|disabled>" for the first match
dt_find() {
    awk -F'\t' -v c="$1" -v a="${2:-}" '{
        n = split($3, cs, " ")
        for (i = 1; i <= n; i++)
            if (cs[i] == c && (a == "" || substr($1, length($1) - length(a)) == "@" a)) {
                print $1 "\t" $2; exit
            }
    }' "$DTIDX"
}
# dev_of NODE -> "<sysfs dir>\t<driver>", preferring an entry with a driver bound
dev_of() {
    awk -F'\t' -v n="$1" '$1 == n { if ($3 != "") { print $2 "\t" $3; f = 1; exit } if (!d) d = $2 }
        END { if (!f && d) print d "\t" }' "$DEVIDX"
}

# drv_avail COMPAT -> "module:<name>", "builtin:<name>" or ""
drv_avail() {
    m=$(awk -v c="$1" '$1 == "alias" { a = $2; sub(/C\*$/, "", a)
            if (substr(a, length(a) - length(c)) == "C" c) { print $3; exit } }' \
        "$MODDIR/modules.alias" 2>/dev/null)
    [ -n "$m" ] && { echo "module:$m"; return; }
    m=$(tr '\0' '\n' <"$MODDIR/modules.builtin.modinfo" 2>/dev/null | awk -v c="$1" '
        { i = index($0, ".alias="); if (!i) next
          a = substr($0, i + 7); sub(/C\*$/, "", a)
          if (substr(a, length(a) - length(c)) == "C" c) { print substr($0, 1, i - 1); exit } }')
    [ -n "$m" ] && echo "builtin:$m"
}

# classify COMPAT CONFIG DEVDIR -> sets CLASS and WHY for an unbound device
classify() {
    c=$1; cfg=$2; d=$3; name=${d##*/}
    if [ -n "$name" ] && [ -r /sys/kernel/debug/devices_deferred ] &&
       r=$(grep -F -- "$name" /sys/kernel/debug/devices_deferred) && [ -n "$r" ]; then
        CLASS=deferred; WHY="probe deferred: $(oneline "$r" | sed "s/^${name}[[:space:]]*//")"
        return
    fi
    av=$(drv_avail "$c")
    case "$av" in
        module:*)
            mod=${av#module:}
            if grep -q "^$mod " /proc/modules 2>/dev/null; then
                CLASS=probe-error; WHY="module $mod loaded but device not bound"
            else
                CLASS=not-loaded; WHY="module $mod exists for $c but is not loaded"
            fi ;;
        builtin:*)
            CLASS=probe-error; WHY="built-in driver ${av#builtin:} did not bind" ;;
        *)
            v=""; [ -n "$cfg" ] && v=$(kconfig "$cfg")
            if [ -n "$cfg" ] && have_kconfig && [ -z "$v" ]; then
                CLASS=config-off; WHY="$cfg is not set (no driver for $c in this kernel)"
            elif [ "$v" = m ]; then
                CLASS=not-loaded; WHY="$cfg=m but no module providing $c is installed"
            elif [ "$v" = y ]; then
                CLASS=probe-error; WHY="$cfg=y but device not bound"
            else
                CLASS=config-off; WHY="no driver matching $c in modules.alias/modules.builtin.modinfo"
            fi ;;
    esac
    [ -z "$d" ] && WHY="$WHY; no device was created for the node"
}

# probe_check ID COMPAT UNITADDR CONFIG DESC
#   PASS if an enabled DT node with COMPAT (at UNITADDR, if given) has a bound
#   driver. Sets NODE, DEV, DRV for follow-up function checks. Returns 0 on PASS.
probe_check() {
    pid=$1; pc=$2; pa=$3; pcfg=$4; pdesc=$5
    NODE=""; DEV=""; DRV=""
    l=$(dt_find "$pc" "$pa")
    if [ -z "$l" ]; then
        repro "find /proc/device-tree -name compatible | xargs grep -l '$pc'"
        res SKIP "$pid" probe not-in-dt "$pdesc: no node compatible with \"$pc\"${pa:+ @$pa} in this DT"
        return 1
    fi
    NODE=${l%%"	"*}
    if [ "${l#*"	"}" = disabled ]; then
        repro "cat /proc/device-tree$NODE/status"
        res SKIP "$pid" probe disabled-in-dt "$pdesc: $NODE is disabled in the DT"
        return 1
    fi
    dl=$(dev_of "$NODE")
    DEV=${dl%%"	"*}; DRV=${dl#*"	"}; [ -n "$dl" ] || { DEV=""; DRV=""; }
    if [ -n "$DRV" ]; then
        repro "readlink $DEV/driver"
        res PASS "$pid" probe "" "$pdesc: driver $DRV bound to $NODE"
        return 0
    fi
    classify "$pc" "$pcfg" "$DEV"
    if [ -n "$DEV" ]; then
        repro "ls -l $DEV/driver; cat /sys/kernel/debug/devices_deferred"
        ev "$(dmesg_for "${DEV##*/}")"
    else
        repro "zcat /proc/config.gz | grep ${pcfg:-<driver option>}; grep -F '$pc' $MODDIR/modules.alias"
    fi
    [ -n "$pcfg" ] && have_kconfig && ev "$pcfg=$(kconfig "$pcfg")"
    res FAIL "$pid" probe "$CLASS" "$pdesc ($NODE): $WHY"
    return 1
}

# first_compat "c1 c2 ..." -> first compatible present in the DT (for features
# whose binding name is not settled upstream yet), or the first one given
first_compat() {
    for fc in $1; do [ -n "$(dt_find "$fc")" ] && { echo "$fc"; return; }; done
    echo "${1%% *}"
}

# --- Environment: everything needed to reproduce the result ---
if ! grep -q ' /sys/kernel/debug ' /proc/mounts; then
    mount -t debugfs none /sys/kernel/debug 2>/dev/null && DBGFS_MOUNTED=1
fi
build_indexes

emit "TAP version 13"
diag "# vf2-selftest $VERSION"
envset script "vf2-selftest $VERSION"
envset date "$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
envset model "$(rd $PDT/model)"
envset dt.compatible "$(tr '\0' ' ' 2>/dev/null <$PDT/compatible)"
envset serial "$(rd $PDT/serial-number)"
envset kernel "$(uname -r)"
envset kernel.build "$(uname -v)"
envset kernel.version "$(cat /proc/version)"
envset kernel.config.md5 "$( (zcat /proc/config.gz 2>/dev/null || echo none) | md5sum | cut -d' ' -f1)"
envset fdt.md5 "$(md5sum /sys/firmware/fdt 2>/dev/null | cut -d' ' -f1)"
envset cmdline "$(cat /proc/cmdline)"
sbi=$(dmesg | sed -n 's/.*SBI implementation ID=\(0x[0-9a-f]*\) Version=\(0x[0-9a-f]*\).*/\1 \2/p' | head -n1)
if [ -n "$sbi" ]; then
    set -- $sbi
    sv=$(($2)); simpl=$1; [ "$1" = 0x1 ] && simpl=OpenSBI
    envset sbi "$simpl $((sv >> 16)).$((sv & 0xffff)), $(dmesg | sed -n 's/.*SBI specification \(v[0-9.]*\).*/\1/p' | head -n1)"
fi
envset u-boot "$(rd $PDT/chosen/u-boot,version)"
envset efi "$([ -d /sys/firmware/efi ] && echo yes || echo no)"
envset rootfs "$(awk '$2 == "/" { print $1 " (" $3 ")" }' /proc/mounts | tail -n1)"
envset os "$(. /etc/os-release 2>/dev/null; echo "${PRETTY_NAME:-unknown}")"
envset uptime "$(cut -d' ' -f1 /proc/uptime)s"

# --- Board identity: everything below assumes a VisionFive 2 device tree ---
model=$(rd $PDT/model)
repro "cat /proc/device-tree/model /proc/device-tree/compatible"
case "$(tr '\0' ' ' 2>/dev/null <$PDT/compatible)" in
    *starfive,visionfive-2*) res PASS board.model probe "" "${model}" ;;
    *) res FAIL board.model probe function "not a VisionFive 2 device tree (model='${model:-none}'); results below are not meaningful" ;;
esac

# --- Boot health ---
ERRS=$(dmesg_raw | grep -E '^<[0-3]>')
nerr=$(printf '%s' "$ERRS" | grep -c .)
repro "dmesg -r | grep -E '^<[0-3]>'"
ev "$(printf '%s\n' "$ERRS" | sed 's/^<[0-3]>//' | head -n 15)"
if [ "$nerr" = 0 ]; then
    res PASS boot.dmesg-errors function "" "no kernel log lines at error level or above"
else
    res FAIL boot.dmesg-errors function log "$nerr kernel log line(s) at error level or above"
fi

if [ -r /sys/kernel/debug/devices_deferred ]; then
    dfr=$(cat /sys/kernel/debug/devices_deferred)
    repro "cat /sys/kernel/debug/devices_deferred"
    ev "$dfr"
    if [ -z "$dfr" ]; then
        res PASS boot.deferred probe "" "no devices left in deferred probe"
    else
        res FAIL boot.deferred probe deferred "$(printf '%s\n' "$dfr" | grep -c .) device(s) stuck in deferred probe"
    fi
else
    res SKIP boot.deferred probe option "debugfs not available (CONFIG_DEBUG_FS)"
fi

taint=$(cat /proc/sys/kernel/tainted)
repro "cat /proc/sys/kernel/tainted"
if [ "$taint" = 0 ]; then
    res PASS boot.taint function "" "kernel not tainted"
else
    ev "$(grep -l . /sys/module/*/taint 2>/dev/null | while read -r t; do
            v=$(cat "$t"); [ -n "$v" ] && echo "${t%/taint} $v"; done | sed 's#/sys/module/##')"
    res FAIL boot.taint function log "kernel tainted ($taint)"
fi

# Upstream kselftests (packaged by vf2-kselftests): reported verbatim, as one
# result each; their own KTAP is kept in the evidence.
KST=/usr/lib/vf2-selftest/kselftest
for t in dt/test_unprobed_devices.sh devices/error_logs/test_device_error_logs.py; do
    tid=kselftest.$(basename "${t%.*}")
    if [ ! -x "$KST/$t" ]; then
        res SKIP "$tid" probe option "upstream kselftest not installed (vf2-kselftests)"
        continue
    fi
    out=$("$KST/$t" 2>&1); rc=$?
    repro "$KST/$t"
    ev "$(printf '%s\n' "$out" | grep -E '^not ok|^# (Totals|FAILED)|^1\.\.' | head -n 20)"
    case $rc in
        0) res PASS "$tid" probe "" "upstream $t passed" ;;
        4) res SKIP "$tid" probe option "upstream $t skipped all tests" ;;
        *) res FAIL "$tid" probe log "upstream $t: $(printf '%s\n' "$out" | grep -c '^not ok') failing case(s)" ;;
    esac
done

# --- CPU, memory, DVFS ---
online=$(cat /sys/devices/system/cpu/online)
nh=$(grep -c '^processor' /proc/cpuinfo)
repro "cat /sys/devices/system/cpu/online"
ev "$(grep -m1 '^isa' /proc/cpuinfo)"
ev "$(grep -m1 '^uarch' /proc/cpuinfo)"
if [ "$online" = 0-3 ] && [ "$nh" = 4 ]; then
    res PASS cpu.harts function "" "4 U74 harts online ($online)"
else
    res FAIL cpu.harts function function "expected 4 harts online, got '$online' ($nh in cpuinfo)"
fi

isa=$(sed -n 's/^isa[[:space:]]*:[[:space:]]*//p' /proc/cpuinfo | head -n1)
repro "grep -m1 ^isa /proc/cpuinfo"
case "$isa" in
    rv64imafdc*) res PASS cpu.isa function "" "$isa" ;;
    *)           res FAIL cpu.isa function function "unexpected ISA string '$isa'" ;;
esac

memkb=$(awk '/^MemTotal:/ { print $2 }' /proc/meminfo)
repro "grep MemTotal /proc/meminfo"
ev "DT memory node(s): $(ls -d $PDT/memory@* 2>/dev/null | sed "s#$PDT/##" | tr '\n' ' ')"
if [ "${memkb:-0}" -gt 1500000 ]; then
    res PASS mem.size function "" "MemTotal $((memkb / 1024)) MiB"
else
    res FAIL mem.size function function "MemTotal only ${memkb:-?} kB"
fi

POL=/sys/devices/system/cpu/cpufreq/policy0
VDD=""
for r in /sys/class/regulator/regulator.*; do
    # mainline names it vdd_cpu, the vendor 6.12 DT vdd-cpu
    case "$(cat "$r/name" 2>/dev/null)" in vdd_cpu|vdd-cpu) VDD=$r ;; esac
done
repro "cat $POL/scaling_driver $POL/scaling_available_frequencies"
if [ -d "$POL" ]; then
    ev "driver=$(cat $POL/scaling_driver) governor=$(cat $POL/scaling_governor)"
    ev "available: $(cat $POL/scaling_available_frequencies 2>/dev/null)"
    res PASS cpu.cpufreq probe "" "$(cat $POL/scaling_driver) policy for cpus $(cat $POL/related_cpus)"

    # Step through every OPP by clamping min=max, read back the frequency the
    # clock framework reports and the vdd_cpu voltage. Restored afterwards.
    omin=$(cat $POL/scaling_min_freq); omax=$(cat $POL/scaling_max_freq)
    echo "echo $omin > $POL/scaling_min_freq; echo $omax > $POL/scaling_max_freq; echo $omin > $POL/scaling_min_freq" >>"$UNDO"
    bad=0; nf=0
    for f in $(cat $POL/scaling_available_frequencies 2>/dev/null); do
        if [ "$f" -gt "$(cat $POL/scaling_max_freq)" ]; then
            echo "$f" >$POL/scaling_max_freq; echo "$f" >$POL/scaling_min_freq
        else
            echo "$f" >$POL/scaling_min_freq; echo "$f" >$POL/scaling_max_freq
        fi
        sleep 0.2 2>/dev/null || sleep 1
        cur=$(cat $POL/cpuinfo_cur_freq 2>/dev/null || cat $POL/scaling_cur_freq); cur=${cur:-0}
        uv=""; [ -n "$VDD" ] && uv=$(cat "$VDD/microvolts" 2>/dev/null)
        ev "set $f kHz -> cur $cur kHz, vdd_cpu ${uv:-?} uV"
        [ "$(( (cur - f) * 100 / f ))" -eq 0 ] || bad=1
        nf=$((nf + 1))
    done
    echo "$omin" >$POL/scaling_min_freq; echo "$omax" >$POL/scaling_max_freq; echo "$omin" >$POL/scaling_min_freq
    repro "echo <f> > $POL/scaling_max_freq; echo <f> > $POL/scaling_min_freq; cat $POL/cpuinfo_cur_freq ${VDD:+$VDD/microvolts}"
    if [ "$nf" = 0 ]; then
        res FAIL cpu.dvfs function function "policy exposes no scaling_available_frequencies (no OPP table?)"
    elif [ "$bad" = 0 ]; then
        res PASS cpu.dvfs function "" "all $nf OPPs reached and read back from the clock framework"
    else
        res FAIL cpu.dvfs function function "an OPP did not read back (see evidence)"
    fi
else
    cf=$(kconfig CONFIG_CPUFREQ_DT)
    ev "CONFIG_CPUFREQ_DT=${cf:-not set}"
    res FAIL cpu.cpufreq probe "$([ -z "$cf" ] && have_kconfig && echo config-off || echo probe-error)" "no cpufreq policy"
    skip_fn cpu.dvfs "no cpufreq policy"
fi

