    eps=$(pci_eps "$DEV")
    repro "lspci -nn  (or: ls /sys/bus/pci/devices)"
    ev "$eps"
    VL805=$(printf '%s\n' "$eps" | awk '$2 == "1106:3483" { print $1 }')
    if [ -n "$VL805" ]; then
        res PASS pcie0.link function "" "link up, VL805 enumerated at $VL805 ($(printf '%s\n' "$eps" | awk '$2 == "1106:3483" { print $5, $6 }'))"
    else
        ev "$(dmesg_for "${DEV##*/}" 5)"
        res FAIL pcie0.link function function "VL805 (1106:3483) not enumerated behind pcie0"
    fi
else
