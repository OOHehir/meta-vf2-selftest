# pci_eps DEVDIR -> lines "<bdf> <vendor>:<device> class=<class> driver=<drv> <speed> x<width>"
pci_eps() {
    for p in /sys/bus/pci/devices/*; do
        r=$(readlink -f "$p")
        case "$r" in "$1"/*) ;; *) continue ;; esac
        cl=$(cat "$p/class")
        case "$cl" in 0x0604*) continue ;; esac   # skip the root port
        printf '%s %s:%s class=%s driver=%s %s x%s\n' "${p##*/}" \
            "$(sed 's/0x//' "$p/vendor")" "$(sed 's/0x//' "$p/device")" "$cl" \
            "$(basename "$(readlink "$p/driver" 2>/dev/null)" 2>/dev/null)" \
            "$(cat "$p/current_link_speed" 2>/dev/null | tr -d ' ')" "$(cat "$p/current_link_width" 2>/dev/null)"
    done
}

