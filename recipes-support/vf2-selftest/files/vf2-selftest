    skip_fn usb.vl805 "VL805 not enumerated"
fi

# A USB mass-storage device, if one is plugged in: read test
usbblk=""
for b in /sys/block/sd*; do
    [ -e "$b" ] && readlink -f "$b" | grep -q /usb && { usbblk=${b##*/}; break; }
done
if [ -n "$usbblk" ]; then
    repro "echo 3 > /proc/sys/vm/drop_caches; dd if=/dev/$usbblk of=/dev/null bs=1M count=64"
    if read_test "/dev/$usbblk" 64; then
        res PASS usb.storage-read function "" "read 64 MiB from /dev/$usbblk at $RT_MBPS MB/s"
    else
        res FAIL usb.storage-read function function "read from /dev/$usbblk failed"
    fi
else
    res SKIP usb.storage-read function hw-absent "no USB storage attached"
fi

if probe_check pcie1.probe starfive,jh7110-pcie 9c0000000 CONFIG_PCIE_STARFIVE_HOST "PCIe1 (M.2 M-key)"; then
    eps=$(pci_eps "$DEV")
    repro "lspci -nn  (or: ls /sys/bus/pci/devices)"
    ev "$eps"
    if [ -z "$eps" ]; then
        res SKIP pcie1.link function hw-absent "nothing enumerated in the M.2 slot (empty?)"
        res SKIP pcie1.nvme-read function hw-absent "no NVMe device"
    else
        res PASS pcie1.link function "" "link up: $(printf '%s\n' "$eps" | head -n1)"
        nv=$(ls /sys/block 2>/dev/null | grep -m1 '^nvme[0-9]*n1$')
        if [ -n "$nv" ]; then
            repro "echo 3 > /proc/sys/vm/drop_caches; dd if=/dev/$nv of=/dev/null bs=1M count=128"
            if read_test "/dev/$nv" 128; then
                res PASS pcie1.nvme-read function "" "read 128 MiB from /dev/$nv at $RT_MBPS MB/s"
            else
                res FAIL pcie1.nvme-read function function "read from /dev/$nv failed"
            fi
        else
            res SKIP pcie1.nvme-read function hw-absent "M.2 device is not NVMe (or nvme driver missing)"
        fi
    fi
else
    skip_fn pcie1.link; skip_fn pcie1.nvme-read
fi

# Wi-Fi: only via a USB adapter on this board
phys=$(ls /sys/class/ieee80211 2>/dev/null)
repro "ls /sys/class/ieee80211; iw dev"
if [ -n "$phys" ]; then
    for ph in $phys; do ev "$ph driver=$(basename "$(readlink /sys/class/ieee80211/$ph/device/driver)")"; done
    res PASS wifi.phy function "" "802.11 phy registered: $(echo $phys)"
else
    res SKIP wifi.phy function hw-absent "no 802.11 phy (no supported Wi-Fi adapter attached)"
fi

# --- Audio ---
probe_check audio.pwmdac starfive,jh7110-pwmdac 100b0000 CONFIG_SND_SOC_JH7110_PWMDAC "PWM-DAC (3.5 mm jack)"
if probe_check audio.card simple-audio-card "" CONFIG_SND_SIMPLE_CARD "PWM-DAC sound card"; then
    cidx=$(ls -d "$DEV"/sound/card* 2>/dev/null | head -n1 | sed 's/.*card//')
    ev "$(cat /proc/asound/cards 2>/dev/null)"
    if [ -z "$cidx" ]; then
        res FAIL audio.play function function "card bound but no ALSA card registered"
    elif ! have aplay; then
        res SKIP audio.play function option "aplay not installed"
    else
        repro "aplay -D plughw:$cidx,0 -f S16_LE -r 48000 -c 2 -d 1 /dev/zero"
        if ao=$(tmo 15 aplay -q -D "plughw:$cidx,0" -f S16_LE -r 48000 -c 2 -d 1 /dev/zero 2>&1); then
            res PASS audio.play function "" "1 s of silence played on card $cidx (no audio output observed)"
        else
            ev "$ao"
            res FAIL audio.play function function "aplay on card $cidx failed"
        fi
    fi
else
    skip_fn audio.play
fi
probe_check audio.i2srx  starfive,jh7110-i2srx 100e0000 CONFIG_SND_SOC_JH7110_I2S "I2S RX"
probe_check audio.i2stx0 starfive,jh7110-i2stx0 120b0000 CONFIG_SND_SOC_JH7110_I2S "I2S TX0"
probe_check audio.i2stx1 starfive,jh7110-i2stx1 120c0000 CONFIG_SND_SOC_JH7110_I2S "I2S TX1"
probe_check audio.tdm    starfive,jh7110-tdm 10090000 CONFIG_SND_SOC_JH7110_TDM "TDM"
probe_check audio.spdif  starfive,jh7110-spdif 100a0000 "" "S/PDIF"
probe_check audio.pdm    starfive,jh7110-pdm 100d0000 "" "PDM microphone input"

# --- Multimedia (largely not in mainline yet: tracked so progress shows up) ---
probe_check camera.csi2rx starfive,jh7110-csi2rx 19800000 CONFIG_VIDEO_CADENCE_CSI2RX "MIPI CSI-2 receiver"
probe_check camera.dphy   starfive,jh7110-dphy-rx 19820000 CONFIG_PHY_STARFIVE_JH7110_DPHY_RX "MIPI D-PHY RX"
probe_check camera.isp    starfive,jh7110-camss "" CONFIG_VIDEO_STARFIVE_CAMSS "camera subsystem (ISP)"
probe_check camera.vin    starfive,jh7110-vin "" "" "camera VIN (vendor)"

c=$(first_compat "img,img-bxe-4-32 img,img-rogue starfive,jh7110-gpu img-gpu")
if probe_check gpu.probe "$c" "" CONFIG_DRM_POWERVR "PowerVR BXE-4-32 GPU"; then
    # render node owned by this device (the vendor DDK may parent it elsewhere,
    # so also accept one whose device is bound to the same driver)
    rn=""
    for r in /sys/class/drm/renderD*; do
        [ -e "$r/device" ] || continue
        rd_=$(readlink -f "$r/device")
        if [ "$rd_" = "$(readlink -f "$DEV")" ] ||
           [ "$(basename "$(readlink "$r/device/driver" 2>/dev/null)" 2>/dev/null)" = "$DRV" ]; then
            rn=$r; break
        fi
    done
    repro "ls -l /dev/dri/ /sys/class/drm/"
    ev "$(ls -l /sys/class/drm/ 2>/dev/null | sed -n 's/.* \(card[0-9]*\|renderD[0-9]*\) -> /\1 -> /p')"
    if [ -n "$rn" ] && [ -c "/dev/dri/${rn##*/}" ]; then
        res PASS gpu.render-node function "" "/dev/dri/${rn##*/} registered by $DRV"
    else
        res FAIL gpu.render-node function function "GPU bound but no render node"
    fi
else
    skip_fn gpu.render-node
fi

c=$(first_compat "starfive,jh7110-dc8200 verisilicon,dc8200 verisilicon,dc")
if probe_check display.dc "$c" "" CONFIG_DRM_VERISILICON_DC "display controller (DC8200)"; then
    conns=$(for k in /sys/class/drm/card*-*; do [ -e "$k/status" ] &&
            echo "${k##*/}=$(cat $k/status)"; done)
    repro "for c in /sys/class/drm/card*-*; do echo \$c \$(cat \$c/status); done"
    ev "$conns"
    if [ -n "$conns" ]; then
        res PASS display.connectors function "" "DRM connectors: $(echo $conns)"
    else
        res FAIL display.connectors function function "display controller bound but no DRM connectors"
    fi
else
    skip_fn display.connectors
fi
c=$(first_compat "starfive,jh7110-inno-hdmi starfive,jh7110-hdmi starfive,jh7110-inno-hdmi-controller")
case $c in
    # upstream series (Wilczynski): its own bridge driver on top of inno-hdmi
    *-controller) cfg=CONFIG_DRM_STARFIVE_JH7110_INNO_HDMI ;;
    *) cfg=CONFIG_DRM_INNO_HDMI ;;
esac
probe_check display.hdmi "$c" "" "$cfg" "HDMI transmitter"
probe_check display.dsi  "$(first_compat "starfive,jh7110-mipi_dsi starfive,jh7110-dsi cdns,dsi")" "" CONFIG_DRM_CDNS_DSI "MIPI DSI host"
probe_check display.dphy-tx "$(first_compat "starfive,jh7110-mipi-dphy-tx starfive,jh7110-dphy-tx")" "" CONFIG_PHY_STARFIVE_JH7110_DPHY_TX "MIPI D-PHY TX"
probe_check video.vpu-dec "$(first_compat "starfive,vdec starfive,jh7110-wave511 cnm,wave511")" "" CONFIG_VIDEO_WAVE_VPU "Wave511 video decoder"
probe_check video.vpu-enc "$(first_compat "starfive,venc starfive,jh7110-wave521c cnm,wave521c")" "" CONFIG_VIDEO_WAVE_VPU "Wave521 video encoder"
probe_check video.jpu "$(first_compat "starfive,jpu starfive,jh7110-jpu cnm,codaj12")" "" "" "JPEG codec (CODAJ12)"
probe_check rtc "$(first_compat "starfive,jh7110-rtc")" "" CONFIG_RTC_DRV_STARFIVE "on-chip RTC"
probe_check timer "starfive,jh7110-timer" 13050000 CONFIG_STARFIVE_JH7110_TIMER "SoC timer"
probe_check can0 "starfive,jh7110-can" 130d0000 "" "CAN 0"
probe_check can1 "starfive,jh7110-can" 130e0000 "" "CAN 1"

# --- Optional stress (CPU + memory with verification), temperature tracked ---
if [ "$STRESS" -gt 0 ] 2>/dev/null; then
    if have stress-ng; then
        e0=$(dmesg_raw | grep -c -E '^<[0-3]>')
        tmax=0
        stress-ng --cpu 4 --vm 2 --vm-bytes 25% --verify -t "${STRESS}s" --metrics-brief >"$TMP/stress" 2>&1 &
        sp=$!
        while kill -0 $sp 2>/dev/null; do
            t=$(cat "$TEMPF" 2>/dev/null || echo 0); [ "$t" -gt "$tmax" ] && tmax=$t
            sleep 2
        done
        wait $sp; src=$?
        e1=$(dmesg_raw | grep -c -E '^<[0-3]>')
        repro "stress-ng --cpu 4 --vm 2 --vm-bytes 25% --verify -t ${STRESS}s"
        ev "$(tail -n 6 "$TMP/stress")"
        ev "max SoC temperature $((tmax / 1000)) C; new error-level kernel log lines: $((e1 - e0))"
        if [ "$src" = 0 ] && [ "$e1" = "$e0" ]; then
            res PASS stress function "" "${STRESS}s CPU+VM stress with verification passed, max $((tmax / 1000)) C"
        else
            res FAIL stress function function "stress-ng rc=$src, $((e1 - e0)) new kernel errors, max $((tmax / 1000)) C"
        fi
    else
        res SKIP stress function option "stress-ng not installed"
    fi
else
    res SKIP stress function option "not requested (--stress SECS)"
fi

# --- Summary, files, baseline comparison ---
emit "1..$N"
diag "# Totals: pass:$P fail:$F skip:$S"

REG=0
if [ -n "$BASELINE" ]; then
    awk -F'\t' '
        NR == FNR { if ($1 !~ /^#/ && NF >= 2) b[$1] = $2; next }
        $1 !~ /^#/ {
            seen[$1] = 1
            if (!($1 in b))                         print "NEW\t" $1 "\t" $2 "\t" $5
            else if (b[$1] == "PASS" && $2 != "PASS") print "REGRESSION\t" $1 "\t" b[$1] " -> " $2 "\t" $5
            else if (b[$1] != "PASS" && $2 == "PASS") print "IMPROVED\t" $1 "\t" b[$1] " -> " $2 "\t" $5
        }
        END { for (k in b) if (!(k in seen)) print "REMOVED\t" k "\t" b[k] }' \
        "$BASELINE" "$RES" >"$TMP/compare"
    REG=$(grep -c '^REGRESSION' "$TMP/compare")
    diag "# Baseline: $BASELINE"
    while IFS= read -r l; do diag "# $(printf '%s' "$l" | tr '\t' ' ')"; done <"$TMP/compare"
    diag "# Regressions: $REG"
fi

if [ -n "$OUTDIR" ]; then
    mkdir -p "$OUTDIR" || exit 2
    cp "$KTAP" "$OUTDIR/ktap.txt"
    { sed 's/^/#env\t/' "$ENVF"; cat "$RES"; } >"$OUTDIR/results.tsv"
    md=$OUTDIR/report.md
    {
        envget() { awk -F'\t' -v k="$1" '$1 == k { print $2 }' "$ENVF"; }
        printf '### VisionFive 2 self-test: %s, Linux %s\n\n' "$(envget model)" "$(envget kernel)"
        printf '**%d pass, %d fail, %d skip** (%d checks)' "$P" "$F" "$S" "$N"
        [ -n "$BASELINE" ] && printf ', **%d regression(s)** vs baseline' "$REG"
        printf '\n\n| Environment | |\n|---|---|\n'
        awk -F'\t' '$2 != "" { gsub(/\|/, "\\|", $2); print "| " $1 " | `" $2 "` |" }' "$ENVF"
        if [ -n "$BASELINE" ] && [ -s "$TMP/compare" ]; then
            printf '\n| Change vs baseline | Check | Was -> now | Detail |\n|---|---|---|---|\n'
            awk -F'\t' '{ gsub(/\|/, "\\|"); print "| " $1 " | `" $2 "` | " $3 " | " $4 " |" }' "$TMP/compare"
        fi
        printf '\n| Check | Result | Level | Class | Detail |\n|---|---|---|---|---|\n'
        awk -F'\t' '{ gsub(/\|/, "\\|", $5); print "| `" $1 "` | " $2 " | " $3 " | " $4 " | " $5 " |" }' "$RES"
        printf '\nLevels: *probe* = DT node enabled and a driver bound; *function* = the feature did something observable.\n'
        printf 'Each result has a `repro:` command and raw evidence in `ktap.txt`. Generated by vf2-selftest %s.\n' "$VERSION"
    } >"$md"
    diag "# wrote $OUTDIR/ktap.txt $OUTDIR/results.tsv $OUTDIR/report.md"
fi

if [ -n "$BASELINE" ]; then
    [ "$REG" = 0 ]; exit $?
fi
[ "$F" = 0 ]
