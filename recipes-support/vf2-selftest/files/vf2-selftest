if probe_check trng.probe starfive,jh7110-trng 1600c000 CONFIG_HW_RANDOM_JH7110 "TRNG"; then
    HR=/sys/class/misc/hw_random
    avail=$(cat $HR/rng_available 2>/dev/null); cur=$(cat $HR/rng_current 2>/dev/null)
    mine=$(printf '%s\n' $avail | grep -i -e jh7110 -e 1600c000 | head -n1)
    ev "rng_available='$avail' rng_current='$cur'"
    if [ -n "$mine" ]; then
        [ "$cur" != "$mine" ] && { echo "echo $cur > $HR/rng_current" >>"$UNDO"; echo "$mine" >$HR/rng_current; }
        tmo 10 dd if=/dev/hwrng of="$TMP/rng" bs=4096 count=1 2>/dev/null
        [ "$cur" != "$mine" ] && echo "$cur" >$HR/rng_current
        nb=$(wc -c <"$TMP/rng" 2>/dev/null); nb=${nb:-0}
        nu=$(bytes "$TMP/rng" 2>/dev/null | sort -u | grep -c .)
        repro "echo $mine > $HR/rng_current; dd if=/dev/hwrng bs=4096 count=1 | od -v -b | awk '{ for (i = 2; i <= NF; i++) print \$i }' | sort -u | wc -l"
        ev "read $nb bytes, $nu distinct byte values"
        # 4096 uniform bytes miss one of 256 values with p ~ 3e-5
        if [ "$nb" = 4096 ] && [ "$nu" -ge 250 ]; then
            res PASS trng.read function "" "4 KiB read from $mine, $nu/256 byte values seen"
        else
            res FAIL trng.read function function "short or low-variety read from $mine ($nb bytes, $nu values)"
        fi
    else
        res FAIL trng.read function function "TRNG bound but not registered with hw_random"
    fi
else
    skip_fn trng.read
fi

