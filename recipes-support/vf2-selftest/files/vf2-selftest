    vdrv=$(basename "$(readlink /sys/bus/pci/devices/$VL805/driver 2>/dev/null)" 2>/dev/null)
    buses=$(ls -d /sys/bus/pci/devices/$VL805/usb* 2>/dev/null | sed 's#.*/##' | tr '\n' ' ')
    repro "ls /sys/bus/pci/devices/$VL805/; lsusb -t"
    ev "$(for u in /sys/bus/usb/devices/*-*; do
            case "${u##*/}" in *:*) continue ;; esac
            printf '%s %s:%s %s %s\n' "${u##*/}" "$(cat $u/idVendor)" "$(cat $u/idProduct)" \
                "$(cat $u/product 2>/dev/null)" "$(cat $u/speed 2>/dev/null)M"; done)"
    unb=$(for i in /sys/bus/usb/devices/*-*:*; do
            [ -e "$i" ] && [ ! -e "$i/driver" ] && echo "${i##*/} class=$(cat $i/bInterfaceClass)"; done)
    [ -n "$unb" ] && ev "interfaces without a driver: $unb"
    if [ "$vdrv" = xhci_hcd ] && [ -n "$buses" ]; then
        res PASS usb.vl805 function "" "xhci_hcd bound to VL805, root hubs: $buses"
    else
