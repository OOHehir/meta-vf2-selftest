# Keep close to stock: every deviation from meta-riscv defaults is a caveat on
# the results, so each belongs in kernel-<name>.inc with its reason. DISTRO unset.

MACHINE ?= "visionfive2"
PACKAGE_CLASSES ?= "package_ipk"

# ---------------------------------------------------------------------------
# Kernel under test: "mainline" (linux-mainline) or "vendor" (linux-starfive-dev).
# Everything else is shared, so results differ only by kernel.
# ---------------------------------------------------------------------------
VF2_KERNEL ?= "mainline"
require conf/vf2-selftest/kernel-${VF2_KERNEL}.inc

# ---------------------------------------------------------------------------
# Bench conveniences (not a product image)
# ---------------------------------------------------------------------------
EXTRA_IMAGE_FEATURES ?= "allow-empty-password empty-root-password allow-root-login serial-autologin-root"

# ---------------------------------------------------------------------------
# Build host (same shared caches as the demo build; adjust or drop)
# ---------------------------------------------------------------------------
BB_NUMBER_THREADS ?= "6"
PARALLEL_MAKE ?= "-j 8"
BB_PRESSURE_MAX_CPU ?= "15000"
BB_PRESSURE_MAX_IO ?= "15000"
BB_PRESSURE_MAX_MEMORY ?= "5000"
DL_DIR ?= "/home/repo/yocto-artifacts/downloads"
SSTATE_DIR ?= "/home/repo/yocto-artifacts/sstate-cache"
BB_SIGNATURE_HANDLER ?= "OEEquivHash"
BB_HASHSERVE ?= "auto"
BB_HASHSERVE_DB_DIR ?= "/home/repo/yocto-artifacts/hashserv/master"
BB_HASHSERVE_UPSTREAM ?= "wss://hashserv.yoctoproject.org/ws"
SSTATE_MIRRORS ?= "file://.* http://sstate.yoctoproject.org/all/PATH;downloadfilename=PATH"
INHERIT += "rm_work"
BB_DISKMON_DIRS ??= "\
    STOPTASKS,${TMPDIR},2G,100K \
    STOPTASKS,${DL_DIR},2G,100K \
    STOPTASKS,${SSTATE_DIR},2G,100K \
    HALT,${TMPDIR},500M,1K \
    HALT,${DL_DIR},500M,1K \
    HALT,${SSTATE_DIR},500M,1K \
"

# ---------------------------------------------------------------------------
# oeqa on real hardware: bitbake vf2-selftest-image -c testimage
# Boot the board on the image first; testimage then connects over SSH.
# ---------------------------------------------------------------------------
IMAGE_CLASSES += "testimage"
TEST_TARGET ?= "simpleremote"
#TEST_TARGET_IP = "192.168.178.xxx"
#TEST_SERVER_IP = "192.168.178.113"
# Upstream generic cases first, then the board self-test.
TEST_SUITES ?= "ping ssh df parselogs vf2_selftest"
# Extra arguments for vf2-selftest under testimage, e.g. "--no-link --stress 120"
#VF2_SELFTEST_ARGS = ""

CONF_VERSION = "2"
